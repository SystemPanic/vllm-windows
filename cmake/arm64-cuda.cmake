# Preloaded with `cmake -C`; forces CUDA import libs to the ARM64 copies.
cmake_minimum_required(VERSION 3.17)
find_package(CUDAToolkit REQUIRED)
set(_L "${CUDAToolkit_TARGET_DIR}/lib/arm64")

function(_arm var lib)
  if(EXISTS "${_L}/${lib}.lib")
    set(${var} "${_L}/${lib}.lib" CACHE FILEPATH "" FORCE)
  else()
    message(WARNING "ARM64 ${lib}.lib not found in ${_L}")
  endif()
endfunction()

# Driver API (cumem_allocator, CUTLASS direct driver calls)
_arm(CUDA_cuda_driver_LIBRARY cuda)
_arm(CUDA_CUDA_LIBRARY        cuda)
_arm(CUDA_DRIVER_LIBRARY      cuda)
# Runtime
_arm(CUDA_cudart_LIBRARY        cudart)
_arm(CUDA_CUDART_LIBRARY        cudart)
_arm(CUDA_CUDART                cudart)
_arm(CUDART_LIBRARY             cudart)
_arm(CUDA_cudart_static_LIBRARY cudart_static)
_arm(CUDA_cudadevrt_LIBRARY     cudadevrt)
# Math libs / NVRTC
_arm(CUDA_cublas_LIBRARY   cublas)
_arm(_CUBLAS_LIBRARY       cublas)
_arm(CUDA_cublasLt_LIBRARY cublasLt)
_arm(_CUBLASLT_LIBRARY     cublasLt)
_arm(CUDA_nvrtc_LIBRARY    nvrtc)
_arm(NVRTC_LIBRARY         nvrtc)
_arm(CUDA_NVRTC_LIB        nvrtc)
_arm(CUDA_curand_LIBRARY   curand)
_arm(CUDA_cufft_LIBRARY    cufft)
_arm(CUDA_cufftw_LIBRARY   cufftw)
_arm(CUDA_cusolver_LIBRARY cusolver)
_arm(CUDA_cusparse_LIBRARY cusparse)
_arm(CUDA_nvml_LIBRARY     nvml)